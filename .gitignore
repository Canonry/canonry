node_modules/
.pnpm-store/
.env
.DS_Store
coverage/
dist/
.tmp/
.zed
*.tsbuildinfo
# Web SPA build output (built by build-web.ts)
packages/canonry/assets/web/
# Build-time copies of skills from repo root (copied by copy-agent-assets.ts)
packages/canonry/assets/agent-workspace/skills/
# Local Conductor worktree scratch dirs
.claude/worktrees/
packages/canonry/assets/assets/
# Generated by build-web.ts — hash refs change on every frontend build
packages/canonry/assets/index.html
packages/canonry/assets/THIRD_PARTY_NOTICES.md
package-lock.json
# Local Claude Code MCP server config — per-developer, not for the repo.
.mcp.json
# The native Canonry plugin ships a repository-owned MCP declaration.
!plugins/canonry/.mcp.json
.spec-completion-map.txt

# npm pack output — a release tarball is never source
*.tgz

# Val Town CLI local state — a machine's pid, last-run time, and branch cursor.
# It churns on every push and means nothing on another machine.
apps/vals/*/.vt/

# impeccable's working files (design system, surface notes, reviews). Local
# design-tool state, not for the repo.
.impeccable/

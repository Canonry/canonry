{
  // Typecheck-only project for the dev-time eval harness (run with tsx, never
  // built or published). It spans src/ because the eval imports the server
  // from source, and it covers the eval's own tests.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "incremental": false
  },
  "include": ["./aero/**/*.ts", "../test/aero-eval-*.test.ts"]
}

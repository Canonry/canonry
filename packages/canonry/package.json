{
  "name": "@canonry/canonry",
  "version": "7.56.1",
  "type": "module",
  "description": "Self-hosted AI visibility (AEO) platform: track how ChatGPT, Claude, Gemini, and Perplexity cite your domain, join it with Search Console, GA4, server-side traffic, and paid media, and fix what you find through agent tools (CLI, REST, MCP). Local SQLite.",
  "keywords": [
    "aeo",
    "answer-engine-optimization",
    "geo",
    "generative-engine-optimization",
    "ai-visibility",
    "citation-tracking",
    "seo",
    "mcp",
    "chatgpt",
    "claude",
    "gemini",
    "perplexity",
    "self-hosted"
  ],
  "license": "MIT",
  "homepage": "https://canonry.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Canonry/canonry.git",
    "directory": "packages/canonry"
  },
  "bugs": {
    "url": "https://github.com/Canonry/canonry/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "canonry": "./bin/canonry.mjs",
    "cnry": "./bin/canonry.mjs",
    "canonry-mcp": "./bin/canonry-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "assets/",
    "package.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:web",
    "build:cli": "node --import tsx scripts/copy-agent-assets.ts && tsup",
    "build:web": "node --import tsx build-web.ts",
    "prepublishOnly": "cp ../../README.md ./README.md && pnpm run build",
    "typecheck": "node ../../scripts/typecheck.mjs --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.package.config.ts",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware src/ test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@canonry/aeo-audit": "7.4.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@google/genai": "^2.30.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "chrome-remote-interface": "^0.34.0",
    "cron-parser": "^5.10.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-layout-noverlap": "0.4.2",
    "node-cron": "^4.6.0",
    "openai": "^7.40.0",
    "pdf-lib": "^1.17.1",
    "pino-pretty": "^13.2.0",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@canonry/canonry-web": "workspace:*",
    "@canonry/canonry-api-client": "workspace:*",
    "@canonry/canonry-api-routes": "workspace:*",
    "@canonry/canonry-config": "workspace:*",
    "@canonry/canonry-contracts": "workspace:*",
    "@canonry/canonry-db": "workspace:*",
    "@canonry/canonry-integration-bing": "workspace:*",
    "@canonry/canonry-integration-cloud-run": "workspace:*",
    "@canonry/canonry-integration-cloudflare-queue": "workspace:*",
    "@canonry/canonry-integration-cloudflare-worker": "workspace:*",
    "@canonry/canonry-integration-commoncrawl": "workspace:*",
    "@canonry/canonry-integration-google": "workspace:*",
    "@canonry/canonry-integration-google-ads": "workspace:*",
    "@canonry/canonry-integration-google-business-profile": "workspace:*",
    "@canonry/canonry-integration-google-places": "workspace:*",
    "@canonry/canonry-integration-google-tag-manager": "workspace:*",
    "@canonry/canonry-integration-openai-ads": "workspace:*",
    "@canonry/canonry-integration-traffic": "workspace:*",
    "@canonry/canonry-integration-wordpress": "workspace:*",
    "@canonry/canonry-intelligence": "workspace:*",
    "@canonry/canonry-provider-answer-services": "workspace:*",
    "@canonry/canonry-provider-cdp": "workspace:*",
    "@canonry/canonry-provider-claude": "workspace:*",
    "@canonry/canonry-provider-gemini": "workspace:*",
    "@canonry/canonry-provider-local": "workspace:*",
    "@canonry/canonry-provider-muse": "workspace:*",
    "@canonry/canonry-provider-openai": "workspace:*",
    "@canonry/canonry-provider-openrouter": "workspace:*",
    "@canonry/canonry-provider-perplexity": "workspace:*",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "@canonry/canonry-integration-typesafe": "workspace:*",
    "typescript": "6.0.3"
  }
}

{
  "name": "canonry",
  "private": true,
  "version": "7.78.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "preinstall": "test ! -f scripts/check-node.mjs || node scripts/check-node.mjs",
    "build": "pnpm --filter @canonry/canonry run build",
    "build:cli": "pnpm --filter @canonry/canonry run build:cli",
    "build:web": "pnpm --filter @canonry/canonry run build:web",
    "typecheck": "pnpm -r --no-sort --workspace-concurrency=4 --no-bail run typecheck && node scripts/typecheck.mjs --noEmit -p scripts/tsconfig.json && node scripts/typecheck.mjs --noEmit -p test/tsconfig.json && node scripts/typecheck.mjs --noEmit -p test-setup/tsconfig.json",
    "typecheck:tsc": "CANONRY_TYPECHECKER=tsc pnpm run typecheck",
    "test": "vitest run",
    "check": "node scripts/lint-changed.mjs",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint:staged": "node scripts/lint-changed.mjs --staged",
    "lint": "pnpm -r --no-sort --workspace-concurrency=4 run lint",
    "gen": "pnpm --filter @canonry/canonry-api-client gen",
    "gen:check": "pnpm --filter @canonry/canonry-api-client gen:check",
    "verify": "pnpm gen:check && pnpm plugin:check && pnpm val:skills:check && pnpm run typecheck && pnpm run typecheck:tsc && pnpm run lint && pnpm run test",
    "plugin:sync": "node scripts/sync-canonry-plugin.mjs",
    "guide:sync": "node scripts/sync-agent-operations.mjs && pnpm plugin:sync && pnpm val:skills",
    "guide:check": "node scripts/sync-agent-operations.mjs --check",
    "plugin:check": "node scripts/sync-canonry-plugin.mjs --check",
    "val:skills": "node scripts/sync-val-town-skills.mjs",
    "val:skills:check": "node scripts/sync-val-town-skills.mjs --check",
    "dev:api": "pnpm --filter @canonry/canonry-api run dev",
    "dev:worker": "pnpm --filter @canonry/canonry-worker run dev",
    "dev:web": "pnpm --filter @canonry/canonry-web run dev",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@tsrs/wasm": "0.18.0-ts7.1.0-dev.20260929",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "better-sqlite3": "^13.0.3",
    "eslint-plugin-regexp": "^3.3.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "license": "MIT"
}

// oxlint configuration — the lint gate for the workspace (`pnpm lint`, `pnpm check`,
// the pre-commit hook). It mirrors the former eslint.config.js rule for rule.
//
// EVERY GUARD HAS ITS OWN RULE ID, and overrides resolve rules by id with
// LAST-WINS semantics: a later block naming the same tree replaces an earlier
// block's options for that rule. Never add selector bans as options on the core
// `no-restricted-syntax` rule — build a rule with createRestrictedSyntaxRule
// (eslint-rules/restricted-syntax.js) under its own id. An exemption is an
// "off" override placed directly after the block it exempts from. See
// docs/GUARDS.md, and add every new guard and exemption to test/lint-guards.test.ts.
//
// Type-aware rules run only with `--type-aware` (`pnpm lint`); the fast check
// (`pnpm check` / pre-commit) runs everything else.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Every rule is opted in explicitly below; none come from oxlint's default categories.
  "categories": { "correctness": "off" },
  "env": { "builtin": true },
  "ignorePatterns": ["dist/","node_modules/","apps/**/dist/","packages/**/dist/","packages/api-client-generated/src/generated/**"],
  "jsPlugins": [
    { "name": "canonry-guards", "specifier": "./eslint-rules/canonry-guards.js" },
    { "name": "canonry-vocabulary", "specifier": "./eslint-rules/canonry-vocabulary.js" },
    { "name": "design-tokens", "specifier": "./eslint-rules/design-tokens.js" },
    "eslint-plugin-regexp"
  ],
  "overrides": [
    // CLI commands must be fully non-interactive. readline is only allowed in
    // init.ts as a human convenience — all init values are also passable via flags.
    {
      "files": ["packages/canonry/src/commands/**/*.ts","packages/canonry/src/cli-commands/**/*.ts"],
      "rules": {
        "no-restricted-imports": ["error",{"paths":[{"name":"node:readline","message":"CLI commands must be non-interactive. Accept values via flags, env vars, or config.yaml."},{"name":"readline","message":"CLI commands must be non-interactive. Accept values via flags, env vars, or config.yaml."}]}]
      }
    },
    {
      "files": ["packages/canonry/src/commands/init.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    // Vocabulary enforcement — see canonry-vocabulary/no-banned-metric-literal in
    // eslint-rules/canonry-vocabulary.js. Overlaps the AI-hostname guard on all four
    // trees, the CLI raw-HTTP guard on the two packages/canonry trees, and the web
    // raw-HTTP guard on apps/web/src. It composes with all three: each has its own rule id.
    {
      "files": ["packages/canonry/src/commands/**/*.ts","packages/canonry/src/cli-commands/**/*.ts","packages/api-routes/src/**/*.ts","apps/web/src/**/*.ts","apps/web/src/**/*.tsx","packages/contracts/src/visibility-display.ts"],
      "rules": {
        "canonry-vocabulary/no-banned-metric-literal": "error"
      }
    },
    // Percent display guard — see eslint-rules/no-inline-percent.js. Every
    // percentage a person reads (CLI text, dashboard, server-built copy, Aero tool
    // text) goes through `formatPercent`, which is the one place that formats a
    // percent inline and so is exempt.
    {
      "files": ["packages/canonry/src/commands/**/*.ts","packages/canonry/src/cli-commands/**/*.ts","packages/canonry/src/agent/**/*.ts","packages/api-routes/src/**/*.ts","packages/intelligence/src/**/*.ts","packages/contracts/src/**/*.ts","apps/web/src/**/*.ts","apps/web/src/**/*.tsx"],
      "rules": {
        "canonry-guards/no-inline-percent": "error"
      }
    },
    {
      "files": ["packages/contracts/src/formatting.ts"],
      "rules": {
        "canonry-guards/no-inline-percent": "off"
      }
    },
    // One query classifier: see eslint-rules/no-second-query-classifier.js. A
    // tracked query is branded or non-brand only through `compileQueryClassifier` or
    // a class an advanced plan stored. Production code only: test fixtures build
    // class values by hand on purpose.
    {
      "files": ["packages/*/src/**/*.ts","apps/**/src/**/*.ts","apps/**/src/**/*.tsx"],
      "rules": {
        "canonry-guards/no-second-query-classifier": "error"
      }
    },
    // The classifier itself (query-class.ts), and Search Console query intent
    // (query-categorize.ts: brand, lead-gen, industry, other) — its own enum over
    // search queries, not the class of a tracked query.
    {
      "files": ["packages/contracts/src/query-class.ts","packages/intelligence/src/query-categorize.ts"],
      "rules": {
        "canonry-guards/no-second-query-classifier": "off"
      }
    },
    // GA4 dimension drift guard — see eslint-rules/canonry-guards.js. This tree is
    // also matched by the AI-hostname guard's `packages/integration-*` glob.
    {
      "files": ["packages/integration-google-analytics/src/**/*.ts"],
      "rules": {
        "canonry-guards/no-inline-ga4-dimension": "error"
      }
    },
    {
      "files": ["packages/integration-google-analytics/src/constants.ts"],

    // transport, which retains response provenance. A URL the operator supplies (a
    // sitemap, a site) is not one of these:
    // it goes through `createGuardedFetch` from api-routes, never raw fetch.
    {
      "files": ["packages/canonry/src/client.ts","packages/canonry/src/commands/daemon.ts","packages/canonry/src/telemetry.ts","packages/canonry/src/update-check.ts","packages/canonry/src/sentiment-openrouter.ts"],
      "rules": {
        "canonry-guards/no-raw-http-cli": "off"
      }
    },
    // Design-token ratchet (Phase 3 complete): no raw Tailwind palette utilities
    // anywhere in themeable web code. See eslint-rules/design-tokens.js.
    {
      "files": ["apps/web/src/**/*.ts","apps/web/src/**/*.tsx"],
      "rules": {
        "design-tokens/no-literal-palette": "error"
      }
    },
    // Permanent exclusions: ProviderBadge encodes engine identity (not tone) and
    // ChartPrimitives carries the `var(--chart-*, #hex)` fallbacks. Both stay literal.
    {
      "files": ["apps/web/src/components/shared/ProviderBadge.tsx","apps/web/src/components/shared/ChartPrimitives.tsx"],
      "rules": {
        "design-tokens/no-literal-palette": "off"
      }
    },
    // Vocabulary ratchet: web UI copy says "query", never "question". Scoped to
    // apps/web/src plus the shared visibility display labels: the frozen route paths
    // and MCP tool names live in packages/api-routes + packages/canonry, so keeping
    // the rule off those trees exempts them structurally instead of by regex.
    {
      "files": ["apps/web/src/**/*.ts","apps/web/src/**/*.tsx","packages/contracts/src/visibility-display.ts"],
      "rules": {
        "canonry-vocabulary/no-question-ui-copy": "error"
      }
    },
    // Permanent exclusions: DiscoverySection is discovery's GENERATIVE framing
    // ("questions your customers might ask") — a genuinely different noun, and no
    // regex separates it from query copy, so the boundary is the file. mock-data.ts
    // is a test fixture with no production consumer.
    {
      "files": ["apps/web/src/components/project/DiscoverySection.tsx","apps/web/src/mock-data.ts"],
      "rules": {
        "canonry-vocabulary/no-question-ui-copy": "off"
      }
    }
  ]
}
